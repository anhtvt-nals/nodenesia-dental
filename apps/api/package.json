{
  "name": "@clinic/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@clinic/shared": "workspace:*",
    "@fastify/multipart": "^8",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "fastify": "^4.28.1",
    "pg-boss": "^10.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "lint": "tsc --noEmit",
    "test": "DATABASE_URL='postgresql://clinic:clinic@localhost:5432/clinic?schema=public' vitest run --exclude 'src/**/*.integration.spec.ts'",
    "test:integration": "DATABASE_URL='postgresql://clinic:clinic@localhost:5432/clinic?schema=public' vitest run src/**/*.integration.spec.ts",
    "seed": "DATABASE_URL='postgresql://clinic:clinic@localhost:5432/clinic?schema=public' tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  }
}
