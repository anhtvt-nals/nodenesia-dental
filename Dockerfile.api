FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV COREPACK_HOME=/opt/corepack

RUN corepack enable && corepack prepare yarn@4.5.3 --activate
COPY package.json yarn.lock .yarnrc.yml turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN yarn install --immutable

COPY apps/api apps/api
COPY packages/shared packages/shared
RUN yarn workspace @clinic/api exec prisma generate
RUN yarn workspace @clinic/api exec tsc --outDir dist

EXPOSE 3000
# Compile the Nest application before runtime so decorator metadata is emitted.
# The tsx loader remains only for the workspace shared package, whose public
# entry is TypeScript; it is loaded by Node directly, never via a Yarn shim.
CMD ["node", "--import", "tsx", "apps/api/dist/main.js"]
