{
  "name": "nodenesia-dental",
  "private": true,
  "packageManager": "yarn@4.5.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@clinic/api --filter=@clinic/web --filter=@clinic/admin",
